# Credentials for the browser end-to-end runs (e2e/). Copy to `.env` and fill in
# whichever provider you have a key for — `.env` is gitignored and is never
# included in `npm run package`.
#
#   cp .env.example .env
#
# Then:
#   npm run e2e:provider            # does the key work at all?
#   npm run e2e:live                # real healing + real advisory on a live page
#
# Nothing else reads this file: the extension itself takes its key from the
# options page, not from the environment.

# Which provider the e2e runs should use: groq | anthropic
# Leave unset and whichever key is filled in below wins (Groq first).
LLM_PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Leave empty for the shipped default (openai/gpt-oss-120b).
# Groq's catalogue turns over and differs per account — `npm run e2e:provider`
# prints the model it used, and the options page can list what your key can run.
GROQ_MODEL=

# https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Leave empty for the shipped default (claude-opus-5).
ANTHROPIC_MODEL=
