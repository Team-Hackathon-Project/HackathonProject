# Credentials for the browser end-to-end runs (e2e/). Copy to `.env` and fill in
# whichever provider you have a key for — `.env` is gitignored and is never
# included in `npm run package`.
#
#   cp .env.example .env
#
# Then:
#   npm run e2e:provider            # does the key work at all?
#   npm run e2e:live                # real healing + real advisory on a live page
#
# Nothing else reads this file: the extension itself takes its key from the
# options page, not from the environment.

# Which provider the e2e runs should use: groq | anthropic
# Leave unset and whichever key is filled in below wins (Groq first).
LLM_PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Leave empty for the shipped default (openai/gpt-oss-120b).
# Groq's catalogue turns over and differs per account — `npm run e2e:provider`
# prints the model it used, and the options page can list what your key can run.
GROQ_MODEL=

# https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Leave empty for the shipped default (claude-opus-5).
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Bright Data Scraping Browser  (agent/ — `npm run agent`, `npm run brightdata`)
# ---------------------------------------------------------------------------
# The full endpoint from the Scraping Browser zone page, "Access parameters" ->
# the Puppeteer/Playwright tab. Copy it AFTER pressing the eye icon: the console
# shows the password as **********, and that masked string is what most people
# paste first. The agent rejects it by name rather than failing with a bare
# authentication error.
#
#   wss://brd-customer-<CUSTOMER ID>-zone-<ZONE NAME>:<PASSWORD>@brd.superproxy.io:9222
#
BRIGHTDATA_BROWSER_URL=

# Alternatives, if you already have the credentials in another shape. The first
# of these three forms that is filled in wins, in this order.
#   BRIGHTDATA_AUTH=brd-customer-<id>-zone-<zone>:<password>
#   BRIGHTDATA_CUSTOMER= / BRIGHTDATA_ZONE= / BRIGHTDATA_PASSWORD=
BRIGHTDATA_AUTH=
BRIGHTDATA_CUSTOMER=
BRIGHTDATA_ZONE=
BRIGHTDATA_PASSWORD=

# The loopback bridge the extension calls. Defaults are fine for one machine.
BRIGHTDATA_BRIDGE_HOST=127.0.0.1
BRIGHTDATA_BRIDGE_PORT=8791
# Optional shared secret. Set it and paste the same value into the extension's
# options page; the bridge then refuses every request that does not carry it.
# Worth setting: the bridge is on localhost, and so is every page in your browser.
BRIGHTDATA_BRIDGE_TOKEN=

# Timeouts, in milliseconds. Unset is fine.
BRIGHTDATA_NAV_TIMEOUT_MS=120000
BRIGHTDATA_CONNECT_TIMEOUT_MS=60000
BRIGHTDATA_CAPTCHA_TIMEOUT_MS=10000
BRIGHTDATA_SETTLE_MS=1500
# Set to false to skip the Captcha.waitForSolve call entirely.
BRIGHTDATA_SOLVE_CAPTCHA=true

# Pin the exit node's location. Bright Data reads these off the proxy username.
# Worth setting: without it the session leaves from wherever there is capacity,
# and a European exit node turns google.com/finance into consent.google.com,
# which carries no quote at all. Two-letter lowercase country code; `eu` works
# as a region. City and state are optional refinements.
BRIGHTDATA_COUNTRY=us
BRIGHTDATA_CITY=
BRIGHTDATA_STATE=
