{
  "name": "self-healing-market-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome MV3 extension: self-healing market scraper and advisory engine.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "lint": "node scripts/validate.mjs",
    "icons": "node scripts/make-icons.mjs",
    "web:sync": "node scripts/web-sync.mjs",
    "web": "node scripts/serve-web.mjs",
    "check": "npm run lint && npm test",
    "package": "npm run web:sync && node scripts/package.mjs",
    "e2e": "node e2e/quote-page.mjs",
    "e2e:heal": "node e2e/self-healing.mjs",
    "e2e:provider": "node e2e/provider-check.mjs",
    "e2e:live": "node e2e/live-quote.mjs",
    "e2e:targets": "node e2e/auto-targets.mjs",
    "e2e:dashboard": "node e2e/dashboard.mjs",
    "agent": "node agent/server.mjs",
    "brightdata": "node agent/cli.mjs",
    "brightdata:check": "node agent/cli.mjs --check",
    "e2e:brightdata": "node e2e/brightdata.mjs"
  },
  "dependencies": {
    "jsdom": "^30.0.1",
    "puppeteer-core": "^23.11.1"
  }
}
